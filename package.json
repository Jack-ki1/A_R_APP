{
  "name": "breakout-radar",
  "version": "0.1.0",
  "private": true,
  "description": "Breakout Radar: internal A&R intelligence MVP (Discovery, Analyse, Recommendations). Simulated data only.",
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "client": "vite",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
