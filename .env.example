# Frontend-safe Supabase project settings (publishable key only)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-side settings for protected server functions (same project/key)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Used only by Drizzle migration commands, never by the browser app.
DATABASE_URL=postgresql://postgres:replace_me@db.your-project-id.supabase.co:5432/postgres

# Server-side encryption key for per-user provider API keys (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the real value. Changing this key makes existing stored provider
# credentials undecryptable — users must re-enter their keys after a change.
PROVIDER_ENCRYPTION_KEY=replace_me_with_a_random_64_char_hex_string
