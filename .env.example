# Frontend-safe Supabase project settings (publishable key only)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-side settings for protected server functions (same project/key)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Used only by Drizzle migration commands, never by the browser app.
DATABASE_URL=postgresql://postgres:replace_me@db.your-project-id.supabase.co:5432/postgres
